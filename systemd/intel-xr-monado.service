[Unit]
Description=Intel XR Monado-ALVR service
StartLimitIntervalSec=60
StartLimitBurst=3
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardInput=null
Environment=XRT_LOG=debug
Environment=XRT_NO_STDIN=true
# TEST ONLY: permit trusted legacy ALVR clients past protocol-ID mismatch.
Environment=ALVR_LEGACY_PROTOCOL_TEST=1
# Current-client discovery fallback while native mDNS resolution is unfinished.
Environment=ALVR_DIRECT_CLIENT_IP=192.168.86.168
# Diagnostic only: set to 1 to overwrite encoder input with bright magenta.
Environment=XR_VIDEO_TEST_PATTERN=1
ExecStart=/ai/intel-xr-prototype/build/monado-alvr/src/xrt/targets/service/monado-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

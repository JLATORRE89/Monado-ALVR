[Unit]
Description=Intel XR Monado-ALVR service
StartLimitIntervalSec=60
StartLimitBurst=3
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardInput=null
Environment=XRT_LOG=debug
Environment=XRT_NO_STDIN=true
# TEST ONLY: permit trusted legacy ALVR clients past protocol-ID mismatch.
Environment=ALVR_LEGACY_PROTOCOL_TEST=1
# Current-client discovery fallback while native mDNS resolution is unfinished.
Environment=ALVR_DIRECT_CLIENT_IP=192.168.86.168
# ALVR wired (USB) mode runs `adb`; without it on PATH ALVR downloads its own
# platform-tools and a second ADB server would fight the SDK's server.
Environment=PATH=/ai/android-sdk/platform-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/ai/intel-xr-prototype/build/monado-alvr/src/xrt/targets/service/monado-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

{
  "paths": {
    "root": "/ai/intel-xr-prototype",
    "android_home": "/ai/android-sdk",
    "java_home": "/usr/lib/jvm/java-17-openjdk-amd64"
  },
  "android": {
    "ndk_version": "25.1.8937393",
    "rust_target": "aarch64-linux-android",
    "platform_api": 32,
    "openxr_sdk_repo": "https://github.com/KhronosGroup/OpenXR-SDK-Source.git",
    "openxr_sdk_ref": "release-1.1.53",
    "usb_stay_awake": true
  },
  "alvr": {
    "legacy_protocol_test": true
  },
  "network": {
    "quest_ip": "192.168.86.168",
    "direct_ip_fallback": true,
    "mdns": true,
    "legacy_udp": true,
    "usb": true
  },
  "video": {
    "test_pattern": false,
    "test_pattern_mode": "static-bars"
  },
  "demo": {
    "openxr_sdk_source": "/ai/intel-xr-prototype/src/OpenXR-SDK-Source",
    "graphics": "Vulkan",
    "form_factor": "Hmd"
  }
}
